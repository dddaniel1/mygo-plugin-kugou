{
  "id": "kugou",
  "name": "KuGou Music",
  "version": "0.1.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": ["gateway.kugou.com", "login-user.kugou.com", "krcs.kugou.com", "lyrics.kugou.com", "m.kugou.com"]
  },
  "settings": [
    {
      "key": "quality",
      "label": "Audio Quality Cap",
      "help": "Highest quality to request: 128, 320 or flac. Above 128 usually needs a signed-in KuGou account.",
      "link": "https://www.kugou.com/"
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "title": "Charts", "page": "charts", "icon": "chart" },
    { "title": "Playlists", "page": "playlists", "icon": "playlist" },
    { "builtin": "liked" },
    { "builtin": "savedAlbums" }
  ]
}
